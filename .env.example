# Rakku Digital Police Assistant - Environment Configuration Template

# Gemini API Key (Required for AI assistant. Get one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL database connection (Used by NestJS backend via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rakku"

# Ports and Endpoint Configurations
PORT=3001
AI_SERVICE_URL="http://localhost:8000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001/api"

###############################################
# SOS EMERGENCY PLATFORM
###############################################

# Enable / Disable Notification Channels
EMERGENCY_NOTIFICATIONS_ENABLED=true

TELEGRAM_ENABLED=false
EMAIL_ENABLED=false

###############################################
# Telegram Bot
###############################################

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

###############################################
# Email Alerts (via Resend)
###############################################

RESEND_API_KEY=your_resend_api_key_here

ALERT_EMAIL=admin_email_to_notify@gmail.com

###############################################
# Emergency Notification Settings
###############################################

NOTIFICATION_THROTTLE_SECONDS=30

EMERGENCY_REFERENCE_PREFIX=SOS-UP

EMERGENCY_DEFAULT_SEVERITY=CRITICAL

###############################################
# Future Integrations (Reserved)
###############################################

SMS_ENABLED=false
WHATSAPP_ENABLED=false

POLICE_API_ENABLED=false
UP112_API_ENABLED=false
CAD_ENABLED=false
